{
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/tools/qr",
      "destination": "/"
    },
    {
      "source": "/tools/qr/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/q/:slug",
      "destination": "/api/q?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
