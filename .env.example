# Postgres connection string from Neon. Server only, never PUBLIC_.
DATABASE_URL=postgresql://user:password@host/qr_ninja?sslmode=require

# Any long random string. Used to hash IPs for the create rate limit so raw
# addresses are never stored. Generate one with: openssl rand -hex 32
IP_HASH_SALT=

# Only set these on Vercel when the app is proxied under the portfolio.
# PUBLIC_BASE_PATH=/tools/qr
# PUBLIC_BASE_URL=https://adityavhlvy.vercel.app
